import Mathlib.Topology.Constructible
import Mathlib.Topology.Clopen

/-! Every finite family of constructible sets is generated by a finite
family of closed sets. The stated universal pullback property records
exactly what is needed to make the original sets clopen on strata. -/
set_option autoImplicit false
noncomputable section
namespace DiamondIntegral.Section5
open Classical Set Topology
universe u
variable {X : Type u} [TopologicalSpace X]

def ClopenGenerated (s : Finset (Set X)) (D : Set X) : Prop :=
  ∀ (Y : Type u) [TopologicalSpace Y] (f : Y → X),
    (∀ C ∈ s, IsClopen (f ⁻¹' C)) → IsClopen (f ⁻¹' D)

theorem constructible_closed_generators (D : Set X) (hD : IsConstructible D) :
    ∃ s : Finset (Set X), (∀ C ∈ s, IsClosed C) ∧ ClopenGenerated s D := by
  induction hD using IsConstructible.empty_union_induction with
  | open_retrocompact U hU _ =>
    refine ⟨{Uᶜ}, ?_, ?_⟩
    · intro C hC
      simpa using (Finset.mem_singleton.mp hC) ▸ hU.isClosed_compl
    · intro Y _ f hf
      simpa using (hf Uᶜ (Finset.mem_singleton_self _)).compl
  | union D hD E hE ihD ihE =>
    obtain ⟨s, hs, hsD⟩ := ihD
    obtain ⟨t, ht, htE⟩ := ihE
    refine ⟨s ∪ t, ?_, ?_⟩
    · intro C hC
      rcases Finset.mem_union.mp hC with hC | hC
      · exact hs C hC
      · exact ht C hC
    · intro Y _ f hf
      exact (hsD Y f (fun C hC => hf C (Finset.mem_union_left _ hC))).union
        (htE Y f (fun C hC => hf C (Finset.mem_union_right _ hC)))
  | compl D hD ihD =>
    obtain ⟨s, hs, hsD⟩ := ihD
    exact ⟨s, hs, fun Y _ f hf => (hsD Y f hf).compl⟩

theorem finite_constructible_closed_generators {ι : Type*} [Fintype ι]
    (D : ι → Set X) (hD : ∀ i, IsConstructible (D i)) :
    ∃ s : Finset (Set X), (∀ C ∈ s, IsClosed C) ∧ ∀ i, ClopenGenerated s (D i) := by
  choose s hs hgen using (fun i => constructible_closed_generators (D i) (hD i))
  refine ⟨Finset.univ.biUnion s, ?_, ?_⟩
  · intro C hC
    obtain ⟨i, _, hi⟩ := Finset.mem_biUnion.mp hC
    exact hs i C hi
  · intro i Y _ f hf
    exact hgen i Y f (fun C hC => hf C (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hC⟩))

end DiamondIntegral.Section5
